# Local testing config. Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#     uv run --env-file .env python -m gh_jira_sync --dry-run --verbose
#
# The action reads its inputs from INPUT_* env vars (the GitHub Actions
# convention), so the same code path runs locally and in CI. `.env` is
# gitignored — never commit real credentials.

# --- Jira Cloud ---------------------------------------------------------------
INPUT_JIRA_BASE_URL=https://your-org.atlassian.net
INPUT_JIRA_EMAIL=you@example.com
INPUT_JIRA_API_TOKEN=your-jira-api-token
INPUT_JIRA_PROJECT_KEY=RD
INPUT_JIRA_EPIC_ISSUE_TYPE_ID=11087
INPUT_JIRA_EXTRA_LABELS=github-auto-sync

# --- GitHub -------------------------------------------------------------------
# A classic/fine-grained PAT with read access to issues on the repo below.
INPUT_GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPOSITORY=malparty/gh-milestones-to-jira-epics-action

# --- Optional -----------------------------------------------------------------
# INPUT_ONLY=3          # sync a single milestone number (must exist on the repo)
INPUT_DRY_RUN=false     # add --dry-run to preview; --no-dry-run forces a live run
INPUT_VERBOSE=true
